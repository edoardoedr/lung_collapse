{
  "_comment": "warp core on the fem_setup of karl04_wall.json (same output_dir; run that config up to fem_setup first, this one writes fem/fit_warp). data_dir / output_dir relative to this file; step inputs relative to data_dir, outputs to output_dir",
  "patient": "karl04",
  "data_dir": "../Input_Data/karl04",
  "output_dir": "../results/karl04_wall",
  "steps": ["fem_fit"],

  "check_inputs": {
    "_comment": "inputs null = taken from the other sections (surface_mesh.input, registration.inflated, hilum.structures). Findings are warnings unless fail_on_warning",
    "collapsed": null,
    "inflated": null,
    "structures": null,
    "outside_tol_mm": 1.0,
    "max_outside_fraction": 0.01,
    "notch_radius_mm": 5.0,
    "notch_depth_mm": 3.0,
    "max_notch_fraction": 0.005,
    "max_volume_ratio": 5.0,
    "raster_spacing_mm": 1.0,
    "fail_on_warning": false
  },

  "surface_mesh": {
    "input": "lung_right_collapsed.vtk",
    "output": "lung_collapsed_mesh.vtp",
    "input_space": "auto",
    "output_space": "LPS",
    "merge_tolerance": 1e-5,
    "pre_smooth_iters": 15,
    "post_smooth_iters": 5,
    "smooth_pass_band": 0.1,
    "target_nodes": 480,
    "max_faces": 1000,
    "shrink_factor": 0.9,
    "max_remesh_attempts": 6,
    "min_points_per_cluster": 12,
    "max_subdivisions": 4,
    "hole_size": 1e4
  },

  "registration": {
    "_comment": "inflated/collapsed: labelmap or closed surface; collapsed null = rasterise the step-2 surface. direction: forward (fixed = collapsed, no inversion) | inverse (fixed = inflated, as in Slicer)",
    "inflated": "lung_right.vtk",
    "inflated_label": null,
    "collapsed": null,
    "collapsed_label": null,
    "surface": null,
    "surface_space": "auto",
    "direction": "inverse",
    "landmarks": null,
    "landmark_points": ["airways", "arteries", "veins", "hilum"],
    "landmark_weight": 0.001,
    "hilum_region_mm": 30.0,
    "output": "lung_inflated_mesh.vtp",
    "output_space": "LPS",
    "raster_spacing_mm": 1.0,
    "crop_margin_mm": 20.0,
    "parameter_maps": ["rigid", "affine", "bspline"],
    "parameter_files": ["elastix/Parameters_Rigid.txt", "elastix/Parameters_Affine.txt", "elastix/Parameters_BSpline.txt"],
    "parameter_overrides": {},
    "random_seed": 42,
    "inversion_tol_mm": 1e-3,
    "inversion_max_iter": 100,
    "inversion_samples": 200000,
    "max_interpolated_nodes": 10,
    "max_unflip_nodes": 40
  },
  "hilum": {
    "_comment": "per structure the largest intersection ring with the lung surface; hilum = centroid of the ring centres. lung must be from the same scan as the trees",
    "lung": "lung_right_collapsed.vtk",
    "structures": {
      "airways": "lung_airways.vtk",
      "arteries": "lung_arteries.vtk",
      "veins": "lung_veins.vtk"
    },
    "output": "hilum_anchor.mrk.json",
    "max_ring_distance_mm": 50.0
  },

  "fem_setup": {
    "_comment": "inputs null = previous steps (reference: registration, target: surface_mesh, anchor: hilum). wall: cavity the lung may not leave, 'reference' = the registered inflated surface, or a file, null = none. clamp radius = sphere radius of anchor_point x anchor_radius_factor",
    "reference": null,
    "target": null,
    "anchor": null,
    "anchor_point": "hilum",
    "anchor_radius_factor": 2.0,
    "anchor_min_points": 20,
    "anchor_growth": 1.1,
    "anchor_max_growth_steps": 10,
    "wall": "reference",
    "wall_tol_mm": 2.0,
    "align": "hilum_rigid",
    "cluster_field": "rigid_residual",
    "feature": "normal",
    "pos_weight": 0.3,
    "levels": [1, 4, 8, 14, 25, 40],
    "mesh_size_mm": 14.0,
    "gmsh_timeout_s": 300
  },

  "fem_fit": {
    "_comment": "solver: name in pipeline/collapse/solvers or 'module:Class'; solver_options go to the core",
    "output": "lung_fem_fit_warp.vtp",
    "run_name": "fit_warp",
    "solver": "warp",
    "solver_options": {"order": 1, "load_steps": 8, "newton_tol": 1e-7, "newton_maxit": 30, "warm_substeps": true,
                       "wall_stiffness": 20.0, "wall_eps": 0.5, "wall_max_updates": 6, "wall_settle_mm": 0.05,
                       "wall_update": "newton", "device": null, "linear_solver": null},
    "E_Pa": 3000.0,
    "nu": 0.40,
    "free_nu": false,
    "nu_bounds": [0.05, 0.40],
    "levels": null,
    "optimizer": "lsq",
    "jacobian": "analytic",
    "lsq_diff_step": 5e-3,
    "lsq_ftol": 1e-6,
    "lsq_xtol": 1e-6,
    "lsq_gtol": 1e-8,
    "q0": 0.5,
    "q_bounds": [-1.0, 3.0],
    "reg": 1.0,
    "sign_check_q": 0.2,
    "target_error_mm": 2.5,
    "time_budget_min": 600,
    "hard_grace_min": 10.0,
    "level_patience": 3,
    "level_min_improve": 0.005,
    "fit_patience": 2,
    "fit_min_improve": 0.02
  }
}
